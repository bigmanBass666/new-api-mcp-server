# Template baseline: LF for text, CRLF for Windows scripts
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Go source: normalize to LF per community standard (gofmt outputs LF)
*.go text eol=lf

# Makefile: requires LF line endings and literal tabs
Makefile text eol=lf
Makefile.* text eol=lf

# Binary files
*.png binary
*.jpg binary
*.ico binary
